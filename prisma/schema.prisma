generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique @db.VarChar(50)
  password    String   @db.VarChar(255)
  name        String   @db.VarChar(100)
  role        Role
  phoneNumber String?  @map("phone_number") @db.VarChar(15)
  createdAt   DateTime @default(now()) @map("created_at")
  parent      Parent?
  student     Student?
  teacher     Teacher?

  @@map("users")
}

model AcademicYear {
  id                  Int                   @id @default(autoincrement())
  year                String                @db.VarChar(10)
  semester            Semester
  isActive            Boolean               @default(true) @map("is_active")
  isLocked            Boolean               @default(false) @map("is_locked")
  classSubjects       ClassSubject[]
  reportCards         ReportCard[]
  studentClassHistory StudentClassHistory[]

  @@map("academic_years")
}

model Class {
  id                  Int                   @id @default(autoincrement())
  className           String                @map("class_name") @db.VarChar(20)
  gradeLevel          Int                   @map("grade_level")
  phase               classes_phase         @default(A)
  homeroomTeacherId   Int?                  @map("homeroom_teacher_id")
  classSubjects       ClassSubject[]
  homeroomTeacher     Teacher?              @relation(fields: [homeroomTeacherId], references: [id])
  reportCards         ReportCard[]
  studentClassHistory StudentClassHistory[]
  students            Student[]

  @@index([homeroomTeacherId], map: "classes_homeroom_teacher_id_fkey")
  @@map("classes")
}

model Student {
  id           Int                   @id @default(autoincrement())
  userId       Int                   @unique @map("user_id")
  nisn         String                @unique @db.VarChar(20)
  classId      Int                   @map("class_id")
  attendances  Attendance[]
  grades       Grade[]
  parents      ParentStudent[]
  reportCards  ReportCard[]
  classHistory StudentClassHistory[]
  quizAnswers  StudentQuizAnswer[]
  class        Class                 @relation(fields: [classId], references: [id])
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId], map: "students_class_id_fkey")
  @@map("students")
}

model Teacher {
  id                            Int            @id @default(autoincrement())
  userId                        Int            @unique @map("user_id")
  nip                           String?        @unique @db.VarChar(30)
  teacherType                   TeacherType    @map("teacher_type")
  classSubjects                 ClassSubject[]
  homeroomOfClasses             Class[]
  reportCardsSignedAsHeadmaster ReportCard[]   @relation("SignedByHeadmaster")
  reportCardsSignedAsTeacher    ReportCard[]   @relation("SignedByTeacher")
  user                          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

model Parent {
  id       Int             @id @default(autoincrement())
  userId   Int             @unique @map("user_id")
  children ParentStudent[]
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parents")
}

model ParentStudent {
  parentId  Int     @map("parent_id")
  studentId Int     @map("student_id")
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId], map: "parent_students_student_id_fkey")
  @@map("parent_students")
}

model Subject {
  id                Int                @id @default(autoincrement())
  subjectName       String             @map("subject_name") @db.VarChar(50)
  type              SubjectType
  kkm               Decimal            @default(70.00) @db.Decimal(5, 2)
  classSubjects     ClassSubject[]
  reportCardDetails ReportCardDetail[]

  @@map("subjects")
}

model ClassSubject {
  id             Int          @id @default(autoincrement())
  classId        Int          @map("class_id")
  subjectId      Int          @map("subject_id")
  teacherId      Int          @map("teacher_id")
  academicYearId Int          @map("academic_year_id")
  assignments    Assignment[]
  attendances    Attendance[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  grades         Grade[]
  materials      Material[]
  quizzes        Quiz[]
  schedules      Schedule[]

  @@index([academicYearId], map: "class_subjects_academic_year_id_fkey")
  @@index([classId], map: "class_subjects_class_id_fkey")
  @@index([subjectId], map: "class_subjects_subject_id_fkey")
  @@index([teacherId], map: "class_subjects_teacher_id_fkey")
  @@map("class_subjects")
}

model Schedule {
  id             Int          @id @default(autoincrement())
  classSubjectId Int          @map("class_subject_id")
  day            Day
  startTime      DateTime     @map("start_time") @db.Time(0)
  endTime        DateTime     @map("end_time") @db.Time(0)
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@index([classSubjectId], map: "schedules_class_subject_id_fkey")
  @@map("schedules")
}

model Material {
  id             Int          @id @default(autoincrement())
  classSubjectId Int          @map("class_subject_id")
  title          String       @db.VarChar(150)
  description    String?      @db.Text
  linkUrl        String       @map("link_url") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at")
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@index([classSubjectId], map: "materials_class_subject_id_fkey")
  @@map("materials")
}

model Assignment {
  id             Int          @id @default(autoincrement())
  classSubjectId Int          @map("class_subject_id")
  title          String       @db.VarChar(150)
  description    String?      @db.Text
  attachmentUrl  String?      @map("attachment_url") @db.VarChar(255)
  dueDate        DateTime?    @map("due_date")
  createdAt      DateTime     @default(now()) @map("created_at")
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  grades         Grade[]

  @@index([classSubjectId], map: "assignments_class_subject_id_fkey")
  @@map("assignments")
}

model Attendance {
  id             Int              @id @default(autoincrement())
  studentId      Int              @map("student_id")
  classSubjectId Int              @map("class_subject_id")
  date           DateTime         @db.Date
  status         AttendanceStatus
  proofUrl       String?          @map("proof_url") @db.VarChar(255)
  note           String?          @db.Text
  classSubject   ClassSubject     @relation(fields: [classSubjectId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, classSubjectId, date], name: "unique_attendance_per_day")
  @@index([classSubjectId], map: "attendances_class_subject_id_fkey")
  @@map("attendances")
}

model Grade {
  id             Int          @id @default(autoincrement())
  studentId      Int          @map("student_id")
  classSubjectId Int          @map("class_subject_id")
  assignmentId   Int?         @map("assignment_id")
  scoreType      ScoreType    @map("score_type")
  score          Decimal      @db.Decimal(5, 2)
  note           String?      @db.VarChar(100)
  assignment     Assignment?  @relation(fields: [assignmentId], references: [id])
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@index([assignmentId], map: "grades_assignment_id_fkey")
  @@index([classSubjectId], map: "grades_class_subject_id_fkey")
  @@index([studentId], map: "grades_student_id_fkey")
  @@map("grades")
}

model Quiz {
  id              Int                 @id @default(autoincrement())
  classSubjectId  Int                 @map("class_subject_id")
  title           String              @db.VarChar(150)
  type            QuizType
  durationMinutes Int                 @map("duration_minutes")
  questions       Question[]
  classSubject    ClassSubject        @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  answers         StudentQuizAnswer[]

  @@index([classSubjectId], map: "quizzes_class_subject_id_fkey")
  @@map("quizzes")
}

model Question {
  id            Int          @id @default(autoincrement())
  quizId        Int          @map("quiz_id")
  questionText  String       @map("question_text") @db.Text
  optionA       String       @map("option_a") @db.Text
  optionB       String       @map("option_b") @db.Text
  optionC       String       @map("option_c") @db.Text
  optionD       String       @map("option_d") @db.Text
  correctAnswer AnswerOption @map("correct_answer")
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId], map: "questions_quiz_id_fkey")
  @@map("questions")
}

model StudentQuizAnswer {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  quizId      Int      @map("quiz_id")
  score       Decimal  @db.Decimal(5, 2)
  completedAt DateTime @default(now()) @map("completed_at")
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([quizId], map: "student_quiz_answers_quiz_id_fkey")
  @@index([studentId], map: "student_quiz_answers_student_id_fkey")
  @@map("student_quiz_answers")
}

model Announcement {
  id         Int        @id @default(autoincrement())
  title      String     @db.VarChar(150)
  content    String     @db.Text
  targetRole TargetRole @default(all) @map("target_role")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("announcements")
}

model SchoolProfile {
  id             Int     @id @default(autoincrement())
  schoolName     String  @map("school_name") @db.VarChar(150)
  npsn           String? @db.VarChar(20)
  address        String? @db.VarChar(255)
  phone          String? @db.VarChar(20)
  email          String? @db.VarChar(100)
  headmasterName String? @map("headmaster_name") @db.VarChar(100)
  accreditation  String? @db.VarChar(5)
  logoUrl        String? @map("logo_url") @db.VarChar(255)
  vision         String? @db.Text
  mission        String? @db.Text

  @@map("school_profile")
}

model ReportCard {
  id                   Int                @id @default(autoincrement())
  studentId            Int                @map("student_id")
  classId              Int                @map("class_id")
  academicYearId       Int                @map("academic_year_id")
  phase                Phase
  totalHadir           Int                @default(0) @map("total_hadir")
  totalSakit           Int                @default(0) @map("total_sakit")
  totalIzin            Int                @default(0) @map("total_izin")
  totalAlpha           Int                @default(0) @map("total_alpha")
  homeroomNote         String?            @map("homeroom_note") @db.Text
  promotionStatus      PromotionStatus?   @map("promotion_status")
  signedByTeacherId    Int?               @map("signed_by_teacher_id")
  signedByHeadmasterId Int?               @map("signed_by_headmaster_id")
  printedAt            DateTime?          @map("printed_at") @db.Date
  details              ReportCardDetail[]
  p3                   ReportCardP3[]
  academicYear         AcademicYear       @relation(fields: [academicYearId], references: [id])
  class                Class              @relation(fields: [classId], references: [id])
  signedByHeadmaster   Teacher?           @relation("SignedByHeadmaster", fields: [signedByHeadmasterId], references: [id])
  signedByTeacher      Teacher?           @relation("SignedByTeacher", fields: [signedByTeacherId], references: [id])
  student              Student            @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYearId], name: "unique_report")
  @@index([academicYearId], map: "report_cards_academic_year_id_fkey")
  @@index([classId], map: "report_cards_class_id_fkey")
  @@index([signedByHeadmasterId], map: "report_cards_signed_by_headmaster_id_fkey")
  @@index([signedByTeacherId], map: "report_cards_signed_by_teacher_id_fkey")
  @@map("report_cards")
}

model ReportCardDetail {
  id                     Int        @id @default(autoincrement())
  reportCardId           Int        @map("report_card_id")
  subjectId              Int        @map("subject_id")
  finalScore             Decimal    @map("final_score") @db.Decimal(5, 2)
  achievedCompetency     String?    @map("achieved_competency") @db.Text
  needsSupportCompetency String?    @map("needs_support_competency") @db.Text
  reportCard             ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject                Subject    @relation(fields: [subjectId], references: [id])

  @@unique([reportCardId, subjectId], name: "unique_subject_per_report")
  @@index([subjectId], map: "report_card_details_subject_id_fkey")
  @@map("report_card_details")
}

model ReportCardP3 {
  id           Int        @id @default(autoincrement())
  reportCardId Int        @map("report_card_id")
  dimension    String     @db.VarChar(50)
  description  String?    @db.Text
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  @@index([reportCardId], map: "report_card_p3_report_card_id_fkey")
  @@map("report_card_p3")
}

model StudentClassHistory {
  id             Int          @id @default(autoincrement())
  studentId      Int          @map("student_id")
  classId        Int          @map("class_id")
  academicYearId Int          @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId], name: "unique_student_per_year")
  @@index([academicYearId], map: "student_class_history_academic_year_id_fkey")
  @@index([classId], map: "student_class_history_class_id_fkey")
  @@map("student_class_history")
}

enum Role {
  admin
  teacher
  student
  parent
  headmaster
}

enum Semester {
  odd
  even
}

enum Phase {
  A
  B
  C
  D
  E
  F
}

enum TeacherType {
  homeroom
  subject_specialist
}

enum SubjectType {
  general
  mulok
}

enum Day {
  senin
  selasa
  rabu
  kamis
  jumat
  sabtu
}

enum AttendanceStatus {
  hadir
  sakit
  izin
  alpha
}

enum ScoreType {
  task_manual
  cbt
  uts
  uas
}

enum QuizType {
  daily
  uts
  uas
}

enum AnswerOption {
  a
  b
  c
  d
}

enum TargetRole {
  all
  teacher
  student
  parent
}

enum PromotionStatus {
  naik
  tidak_naik
  lulus
}

enum classes_phase {
  A
  B
  C
  D
  E
  F
}
